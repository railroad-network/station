// The mobile FFI contract (ADR-0007). This UDL is the single source of truth
// for the Swift, Kotlin, and React Native bindings — keep it NARROW: only the
// operations the mobile app actually performs. A small surface is a small
// attack surface and a small maintenance surface.
//
// M1.1 T1.1.1 scope: the four rrn-crypto primitives (Keypair, PublicKey,
// Signature, Hash). Address parsing (T1.1.3) reused those types. The wallet
// file format (T1.1.5) adds WalletContents + EncryptedWallet below;
// SignedPayload / dcbor (T1.1.7) extends this contract in its own task.
//
// Deliberately NOT exposed: SecretKey. The secret seed never crosses the FFI
// boundary in the clear — mobile holds it inside an opaque Keypair and never
// extracts raw bytes (the no-export-secret rule from ADR-0006).

namespace rrn_mobile_ffi {
    // Whether `address` is a well-formed `rrn1…` address (correct bech32m
    // checksum, HRP, length, and a valid curve point). Never throws.
    boolean is_valid_address(string address);

    // Serializes a signed-payload value to canonical (deterministic) dCBOR bytes
    // (T1.1.7, ADR-0002). `payload_json` is the mobile tagged-value model: each
    // node is a single-key object — {"text":…}, {"int":"<decimal>"},
    // {"bytes":"<hex>"}, {"bool":…}, {"null":null}, {"array":[…]}, or
    // {"map":[["key",node],…]}. The returned bytes are byte-identical to what
    // rrn_crypto::serialize::to_canonical_bytes produces for the equivalent Rust
    // value, so a signature over them verifies on the station and vice versa.
    // Floats are forbidden (PayloadError::FloatForbidden); there is no float tag.
    [Throws=PayloadError]
    bytes canonical_bytes(string payload_json);

    // Reads the non-secret metadata off a distributable recovery shard payload
    // (the bytes from RecoveryPackage.shard_payload), for a holder's receive
    // flow (T1.2.3). Does not decrypt the shard — only surfaces the routing
    // metadata so the holder app can confirm the shard is addressed to it and
    // file the payload under `original_address`. `Corrupt` if the bytes are not
    // canonical CBOR or do not match the payload shape.
    [Throws=RecoveryError]
    ShardInfo parse_shard_payload(bytes payload);

    // Reads which identity a recovery request targets (T1.11.3 slice D), so a
    // holder's app can show what it is being asked to help recover before
    // contributing a shard. `Corrupt` if the request bytes are malformed.
    [Throws=RecoveryError]
    RecoveryRequestInfo parse_recovery_request(bytes request_payload);

    // A holder's contribution to a recovery ceremony (T1.11.3 slice D): turns
    // the shard the holder stored into a raw Shamir share re-sealed to the
    // operator's ephemeral recovery key (carried in `request_payload`). The raw
    // share never leaves in the clear — only the recovery secret opens the
    // returned response. `AddressMismatch` if the held shard is for a different
    // identity than the request targets; `Corrupt` on malformed input.
    [Throws=RecoveryError]
    bytes respond_to_recovery(WalletContents wallet, bytes stored_shard_payload, bytes request_payload);

    // ---- Delay-tolerant submission (T2.4.2, ADR-0020) --------------------
    // Signed records cross as portable `{signer, sig, body}` envelope bytes; an
    // outbox entry envelope returned by `outbox_next_entry` is exactly what
    // `bundle_assemble` consumes and what the next `outbox_next_entry` takes as
    // its `prev_entry`. The signing secret stays in Rust (`Keypair` handle).

    // Builds + signs the next entry in `author`'s outbox chain, wrapping one
    // already-signed application record (`record_envelope`, a `{signer,sig,body}`
    // envelope, carried verbatim). Position and prev_hash come from `prev_entry`
    // (the previously returned envelope) — position 0 / all-zero prev_hash when
    // null. Returns the new entry as `{signer,sig,body}` envelope bytes.
    [Throws=DtnError]
    bytes outbox_next_entry(Keypair author, bytes? prev_entry, bytes record_envelope, i64 authored_at);

    // Assembles a carriage bundle from outbox entry envelopes. The result is
    // structurally validated against the station's own decode (size/count caps,
    // same-author order), so it is one the station will accept.
    [Throws=DtnError]
    bytes bundle_assemble(sequence<bytes> entry_envelopes, i64 assembled_at);

    // Decodes a bundle into per-entry display data for a courier UI (counts,
    // authors, record hashes/kinds, validity). Applies the station's structural
    // decode bounds.
    [Throws=DtnError]
    BundleInfo bundle_parse(bytes bundle_bytes);

    // Verifies a station delivery receipt's signature (refusing a receipt not
    // signed by `expected_station_pubkey`) and returns one typed outcome per
    // presented record.
    [Throws=DtnError]
    sequence<ReceiptOutcome> receipt_parse(bytes receipt_bytes, bytes expected_station_pubkey);

    // ---- Escrowed offline spending (T2.4.2, ADR-0021) --------------------

    // Signs a member's request for a headroom certificate, returning it as
    // `{signer,sig,body}` envelope bytes. Never throws.
    bytes certificate_request_sign(Keypair member, i64 cap_centi, u64 nonce, i64 requested_at);

    // Parses a station-signed certificate, verifying the station signature
    // (refusing one not signed by `expected_station_pubkey`), and returns its
    // non-secret fields.
    [Throws=CertError]
    CertificateInfo certificate_parse(bytes cert_envelope_bytes, bytes expected_station_pubkey);

    // Signs a cert-backed offline spend against `cert_id`, returning it as
    // `{signer,sig,body}` envelope bytes — the bytes a receiver passes to
    // `offline_spend_verify` and that `outbox_next_entry` later wraps.
    [Throws=CertError]
    bytes proposal_sign_with_certificate(Keypair sender, string receiver_address, i64 amount_centi, string? memo, bytes cert_id, u64 nonce, i64 proposed_at, i64 expires_at);

    // The ADR-0021 §3 receiver ritual, offline, in one call: verify the
    // certificate's station signature, the proposal's signature and sender, that
    // the certificate is for the sender and the proposal references it, that the
    // spend is addressed to `receiver_address` (the verifier's own address), that
    // the amount is a positive debit, that the proposal is not otherwise
    // inadmissible (window/memo/tier), that the proposal and certificate are
    // unexpired at `now` (the receiver's clock — testimony), that each
    // presented-history entry verifies and references this certificate, and that
    // the amount fits the allowance left (cap − Σ history). Returns a verdict;
    // never throws.
    OfflineSpendVerdict offline_spend_verify(bytes cert_envelope, bytes proposal_envelope, sequence<bytes> presented_history, string receiver_address, bytes station_pubkey, i64 now);
};

// Flat error surface for canonical_bytes. Mirrors the tagged-value failure modes
// without leaking parser internals.
[Error]
enum PayloadError {
    "InvalidJson",
    "MalformedNode",
    "FloatForbidden",
    "InvalidInt",
    "InvalidBytes",
};

// Flat error surfaced to Swift/Kotlin/TS for every fallible constructor. The
// variants mirror the crate-local parse errors without leaking their internals.
[Error]
enum CryptoError {
    "WrongLength",
    "InvalidEncoding",
    "InvalidSignature",
    "InvalidAddress",
    "SealFailed",
};

// An Ed25519 keypair. Opaque: the secret seed stays on the Rust side.
interface Keypair {
    // Generates a fresh keypair from the OS CSPRNG.
    [Name=generate]
    constructor();

    PublicKey public_key();

    Signature sign(bytes message);

    // Opens a sealed box addressed to this keypair's public key (ADR-0008
    // transport envelope). `sealed_box` is the opaque framing PublicKey.seal
    // produced; the secret seed never crosses the FFI boundary. SealFailed on a
    // wrong key, wrong context, truncated framing, or tampering.
    [Throws=CryptoError]
    bytes open(bytes sealed_box);
};

// An Ed25519 public key (32 compressed bytes, validated as a curve point).
interface PublicKey {
    [Name=from_bytes, Throws=CryptoError]
    constructor(bytes data);

    // Parses a bech32m `rrn1…` address back into the public key it encodes.
    [Name=from_address, Throws=CryptoError]
    constructor(string address);

    bytes to_bytes();

    // The bech32m `rrn1…` address for this key (via rrn-identity).
    string to_address();

    boolean verify(bytes message, Signature signature);

    // Seals `plaintext` so only the holder of this key's secret can open it
    // (ADR-0008 transport envelope), returning the opaque `eph ‖ nonce ‖ ct`
    // framing. Used by the mobile to seal a request to its paired station; the
    // station opens it with the matching secret. Uses the shared transport KDF
    // context, distinct from the recovery-shard one.
    [Throws=CryptoError]
    bytes seal(bytes plaintext);
};

// An Ed25519 signature (64 bytes: R ‖ S).
interface Signature {
    [Name=from_bytes, Throws=CryptoError]
    constructor(bytes data);

    bytes to_bytes();
};

// A Blake3 content hash (32 bytes).
interface Hash {
    [Name=of]
    constructor(bytes data);

    bytes to_bytes();

    string to_hex();
};

// ---------------------------------------------------------------------------
// Wallet file format (T1.1.5). A `.rrnwallet` is the canonical-CBOR encoding of
// an EncryptedWallet: the identity's secret sealed with XChaCha20-Poly1305
// under an argon2id key derived from the user's passphrase. Mobile goes through
// rrn-identity for this — it never reimplements the format — so a wallet
// created on mobile opens on the station and vice versa.

// Flat error surface for the fallible wallet operations. Deliberately coarse:
// `Decrypt` covers both a wrong passphrase and tampered ciphertext (the two are
// not distinguished, on purpose), and the crate-local detail stays in Rust.
[Error]
enum WalletError {
    "Decrypt",
    "UnsupportedVersion",
    "Corrupt",
    "Kdf",
};

// The decrypted, in-memory contents of a wallet: one identity plus metadata.
// Opaque — the secret seed never crosses the FFI boundary. Signing capability
// is reached through keypair(), which keeps the secret inside Rust (the
// no-export-secret rule from ADR-0006).
interface WalletContents {
    // Generates a brand-new identity: a fresh keypair, empty metadata, and
    // created_at set to the current Unix time.
    [Name=create_new]
    constructor();

    PublicKey public_key();

    // The bech32m `rrn1…` address of this identity.
    string address();

    // Unix seconds when the identity was created.
    i64 created_at();

    // Arbitrary, non-secret user metadata (labels, display name, …).
    record<string, string> metadata();

    // The keypair for this identity, for signing. The secret stays in Rust.
    Keypair keypair();
};

// A wallet sealed for storage. Its `to_bytes` is the `.rrnwallet` file content;
// mobile persists those bytes in the OS keychain/keystore (double protection:
// passphrase encryption plus Keychain/Keystore at-rest).
interface EncryptedWallet {
    // Seals `contents` under `passphrase` with a fresh random salt and nonce.
    [Name=encrypt, Throws=WalletError]
    constructor(WalletContents contents, string passphrase);

    // Parses the canonical-CBOR `.rrnwallet` bytes. `Corrupt` if the bytes are
    // not valid canonical CBOR or do not match the wallet layout.
    [Name=from_bytes, Throws=WalletError]
    constructor(bytes data);

    // Opens the wallet, returning its decrypted contents. A wrong passphrase or
    // tampered ciphertext yields `Decrypt` — never garbage plaintext.
    [Throws=WalletError]
    WalletContents decrypt(string passphrase);

    // The canonical-CBOR `.rrnwallet` bytes.
    bytes to_bytes();
};

// ---------------------------------------------------------------------------
// Social recovery (T1.2.3). Split the wallet secret into N shards sealed to N
// holders, any K of which reconstruct — see rrn-identity's `recovery` module.
// This FFI exposes only the setup + holder-receive half of the ritual: build a
// package, read out one sealed shard payload per holder to distribute, and (on
// the holder side) read a scanned payload's routing metadata. Reconstruction is
// not on this surface. The wallet secret never crosses the boundary.

// Flat error surface for recovery. Coarse by design; the crate-local detail
// stays in Rust. `Internal` covers underlying-crate variants that cannot arise
// on this surface (it never reconstructs, re-derives an address, or does I/O).
[Error]
enum RecoveryError {
    "TooManyHolders",
    "InvalidParameters",
    "InvalidHolderAddress",
    "ShardIndexOutOfRange",
    "Encryption",
    "Corrupt",
    "AddressMismatch",
    "Internal",
};

// Non-secret description of a recovery request, for a holder's confirm screen
// (via `parse_recovery_request`). Names the identity being recovered.
dictionary RecoveryRequestInfo {
    string target_address;
};

// Non-secret metadata read off a distributable shard payload by the holder's
// app (via `parse_shard_payload`). `holder_address` is the identity this shard
// is sealed to — the receiver can check it matches their own ("is this for
// me?"); `original_address` is the identity being recovered (the storage key).
dictionary ShardInfo {
    string original_address;
    string holder_address;
    u8 threshold;
    u8 total;
};

// A social-recovery package: N shards of the wallet secret, each sealed to a
// holder, any K of which reconstruct. Opaque — the secret material stays in
// Rust; only the per-holder sealed shard payloads leave, one at a time.
interface RecoveryPackage {
    // Splits `wallet`'s secret into one sealed shard per entry in
    // `holder_addresses`, requiring `threshold` (K) of the holders
    // (N = holder_addresses.len()) to reconstruct. Each holder address is a
    // bech32m `rrn1…` string; K must satisfy 2 <= K <= N <= 16.
    [Name=create, Throws=RecoveryError]
    constructor(WalletContents wallet, sequence<string> holder_addresses, u8 threshold);

    // K — decrypted shards required to reconstruct.
    u8 threshold();

    // N — total shards / holders.
    u8 total();

    // The number of sealed shards (equals `total`); valid indices for
    // `shard_payload` are `0..shard_count`.
    u32 shard_count();

    // The self-contained, distributable payload for the shard at `index`:
    // canonical CBOR of {original_address, threshold, total, sealed shard}. The
    // holder scans this (e.g. as a QR) and stores it. Only that holder's secret
    // key can open the sealed shard, so it is safe over an untrusted channel.
    [Throws=RecoveryError]
    bytes shard_payload(u32 index);
};

// ---------------------------------------------------------------------------
// Delay-tolerant submission (T2.4.2, ADR-0020). Thin marshalling over
// rrn-protocol so the app builds/carries its own outbox chain, assembles and
// inspects bundles, and reads station delivery receipts. See src/dtn.rs.

// Flat error surface for the DTN operations. Coarse by design; the crate-local
// detail stays in Rust.
[Error]
enum DtnError {
    "MalformedEnvelope",
    "RecordSignatureInvalid",
    "InvalidChain",
    "BundleTooLarge",
    "TooManyEntries",
    "EntriesOutOfOrder",
    "StationSignatureInvalid",
    "InvalidKey",
};

// One entry's display data in a parsed bundle (for a courier UI). `record_kind`
// is the wrapped record's `kind` discriminant (e.g. "rrn.tx.proposal"), or the
// empty string if it is not a kind-tagged map. `valid` reports whether the
// entry's signatures check out.
dictionary BundleEntryInfo {
    string author;
    u64 position;
    string record_hash;
    string record_kind;
    boolean valid;
};

// Display data for a parsed bundle. Inspection only — no admission, no secret.
dictionary BundleInfo {
    u32 entry_count;
    i64 assembled_at;
    sequence<BundleEntryInfo> entries;
};

// One record's fate in a parsed delivery receipt. `seq` is present exactly for
// the "admitted"/"known" outcomes; `reason` (a machine-stable refusal slug)
// exactly for "refused".
dictionary ReceiptOutcome {
    string record_hash;
    string outcome;
    u64? seq;
    string? reason;
};

// ---------------------------------------------------------------------------
// Escrowed offline spending (T2.4.2, ADR-0021). Thin marshalling over
// rrn-ledger's escrow / transaction types. See src/cert.rs.

// Flat error surface for the fallible certificate operations.
[Error]
enum CertError {
    "InvalidAddress",
    "InvalidCertId",
    "InvalidKey",
    "MalformedCertificate",
    "StationSignatureInvalid",
};

// Non-secret description of a headroom certificate, for a cert-wallet UI.
// `cert_id` is hex; `expires_at` is the receiver-side validity boundary
// offline_spend_verify checks.
dictionary CertificateInfo {
    string member;
    i64 cap_centi;
    i64 issued_at;
    i64 expires_at;
    string cert_id;
};

// The receiver's verdict on an offline cert-backed spend (ADR-0021 §3). Exactly
// one variant is returned. `Ok.remaining_centi` is the allowance left after this
// spend (cap − presented history − amount); every other variant is a typed
// refusal reason.
[Enum]
interface OfflineSpendVerdict {
    Ok(i64 amount_centi, i64 remaining_centi);
    MalformedCertificate();
    BadCertificateSignature();
    MalformedProposal();
    BadProposalSignature();
    CertMemberMismatch();
    CertNotReferenced();
    WrongReceiver();
    NotADebit();
    CertExpired();
    ProposalExpired();
    ProposalInadmissible();
    Overspent(i64 available_centi, i64 attempted_centi);
    MalformedHistory();
};
